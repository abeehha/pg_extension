CREATE TABLE packages(
    name text,
    version semver
);
INSERT INTO packages VALUES
('pkg1', '1.0.0'),
('pkg2', '2.1.0'),
('pkg3', '3.0.0'),
('pkg4', '1.10.0');
SELECT * FROM packages
ORDER BY version;
 name | version 
------+---------
 pkg1 | 1.0.0
 pkg4 | 1.10.0
 pkg2 | 2.1.0
 pkg3 | 3.0.0
(4 rows)

SELECT MAX(version) AS max_version
FROM packages;
 max_version 
-------------
 3.0.0
(1 row)

SELECT MIN(version) AS min_version
FROM packages;
 min_version 
-------------
 1.0.0
(1 row)

SELECT name, version, bump_minor(version) AS next_minor
FROM packages
WHERE is_compatible(version, '1.0.0'::semver)
ORDER BY version;
 name | version | next_minor 
------+---------+------------
 pkg1 | 1.0.0   | 1.1.0
 pkg4 | 1.10.0  | 1.11.0
(2 rows)

